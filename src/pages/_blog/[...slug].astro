---
/**
 * Blog post template — one page is created for every Markdown file in
 * src/content/blog/. The file name becomes the address (/blog/<file-name>).
 */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/ui/Prose.astro';
import LatestPostsSection from '../../components/sections/LatestPostsSection.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import AlertSignupSection from '../../components/sections/AlertSignupSection.astro';
import { getPublishedPosts } from '../../utils/posts';
import { formatDate } from '../../utils/format';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, category, pubDate, image, imageAlt } = post.data;

// Up to two other posts to suggest at the bottom.
const morePosts = (await getPublishedPosts()).filter((p) => p.id !== post.id).slice(0, 2);
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="post-header">
      <div class="container">
        <div class="head">
          <a class="back" href="/blog"><span aria-hidden="true">←</span>&nbsp;All posts</a>
          <p class="meta">
            <span class="cat">{category}</span>
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate, 'long')}</time>
          </p>
          <h1>{title}</h1>
          <p class="lead">{description}</p>
        </div>
      </div>
    </header>

    {
      image && (
        <div class="container">
          <Image
            class="hero"
            src={image}
            alt={imageAlt ?? ''}
            width={1200}
            widths={[640, 960, 1200]}
            sizes="(min-width: 1240px) 1144px, calc(100vw - 40px)"
            loading="eager"
          />
        </div>
      )
    }

    <div class="container body">
      <Prose>
        <Content />
      </Prose>
    </div>
  </article>

  <CtaBand />
  {morePosts.length > 0 && <LatestPostsSection posts={morePosts} title="More from the blog" />}
  <AlertSignupSection />
</BaseLayout>

<style>
  .post-header {
    padding-top: clamp(40px, 5vw, 80px);
    padding-bottom: clamp(24px, 3vw, 40px);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 820px;
  }
  .back {
    align-self: flex-start;
    font-weight: 700;
    font-size: 15px;
    color: var(--green);
    text-underline-offset: 3px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--green);
  }
  .meta time {
    font-weight: 500;
    color: var(--text-subtle);
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(36px, 4.2vw, 56px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--green-deep);
    text-wrap: balance;
  }
  .lead {
    max-width: 40em;
    font-size: clamp(19px, 1.6vw, 22px);
    line-height: 1.5;
    color: var(--text);
    text-wrap: pretty;
  }

  .hero {
    width: 100%;
    max-width: 1000px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 10px;
  }
  .body {
    padding-block: clamp(32px, 4vw, 56px) clamp(56px, 7vw, 104px);
  }
</style>
