---
/** Home page — assembled from section components in src/components/sections/. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import StatsSection from '../components/sections/StatsSection.astro';
import AboutTimeSection from '../components/sections/AboutTimeSection.astro';
import ResearchSection from '../components/sections/ResearchSection.astro';
import BoardSection from '../components/sections/BoardSection.astro';
import BillSection from '../components/sections/BillSection.astro';
import CoalitionSection from '../components/sections/CoalitionSection.astro';
import LatestPostsSection from '../components/sections/LatestPostsSection.astro';
import AlertSignupSection from '../components/sections/AlertSignupSection.astro';
import { getPublishedPosts } from '../utils/posts';
import { SITE } from '../config/site';

const latestPosts = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout>
  <Hero />
  <StatsSection />
  <AboutTimeSection />
  <ResearchSection />
  <BoardSection />
  <BillSection />
  <CoalitionSection />
  {SITE.showBlog && <LatestPostsSection posts={latestPosts} />}
  <AlertSignupSection />
</BaseLayout>
