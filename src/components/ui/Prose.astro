---
/**
 * Prose — wraps long-form text (Markdown articles) and styles everything inside:
 * headings, paragraphs, lists, quotes, links and images. Used by blog posts and
 * any other page whose body is written in Markdown.
 */
---

<div class="prose"><slot /></div>

<style>
  .prose {
    max-width: 720px;
    font-size: 19px;
    line-height: 1.7;
    color: var(--ink);
  }
  .prose > :global(* + *) {
    margin-top: 1.1em;
  }

  .prose :global(h2),
  .prose :global(h3) {
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--green-deep);
    text-wrap: balance;
  }
  .prose :global(h2) {
    margin-top: 2em;
    font-size: clamp(26px, 2.4vw, 32px);
    line-height: 1.2;
    letter-spacing: -0.005em;
  }
  .prose :global(h3) {
    margin-top: 1.8em;
    font-size: 22px;
    line-height: 1.25;
  }
  .prose :global(h2 + *),
  .prose :global(h3 + *) {
    margin-top: 0.6em;
  }
  .prose > :global(:first-child) {
    margin-top: 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li + li) {
    margin-top: 0.4em;
  }
  .prose :global(li::marker) {
    color: var(--green);
  }

  .prose :global(a) {
    color: var(--green);
    font-weight: 600;
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) {
    color: var(--green-deep);
  }

  .prose :global(blockquote) {
    margin-block: 1.6em;
    padding-left: 20px;
    border-left: 3px solid var(--gold);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15em;
    line-height: 1.5;
    color: var(--green-deep);
  }
  .prose :global(blockquote p + p) {
    margin-top: 0.6em;
  }

  .prose :global(img) {
    border-radius: 8px;
  }
  .prose :global(hr) {
    margin-block: 2em;
    border: 0;
    border-top: 1px solid var(--line-strong);
  }
  .prose :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--tint);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
</style>
