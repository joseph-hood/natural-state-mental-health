---
/**
 * ArrowLink — bold text link that ends in an arrow, e.g. "All posts →".
 * The arrow is decorative, so screen readers skip it.
 */
interface Props {
  href: string;
  class?: string;
  [attr: string]: unknown;
}

const { href, class: className, ...rest } = Astro.props;
---

<a class:list={['arrow-link', className]} href={href} {...rest}>
  <slot />&nbsp;<span aria-hidden="true">→</span>
</a>

<style>
  .arrow-link {
    font-weight: 700;
    color: var(--link-color, var(--green));
    text-underline-offset: 3px;
  }
  .arrow-link:hover {
    color: var(--green-deep);
  }
</style>
