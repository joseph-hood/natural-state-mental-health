---
/**
 * Button — renders a link (<a>) when you give it an `href`, otherwise a <button>.
 *
 *   <Button href="/donate">Donate</Button>
 *   <Button variant="outline" href="/join">Join the Coalition</Button>
 *   <Button variant="solid" type="submit" block>Sign up</Button>
 *
 * variant: primary (gold), outline (green outline), solid (green fill)
 * size:    md (default) or sm (used in the header)
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'solid';
  size?: 'sm' | 'md';
  /** Stretch to the full width of its container. */
  block?: boolean;
  class?: string;
  [attr: string]: unknown;
}

const { href, variant = 'primary', size = 'md', block = false, class: className, ...rest } = Astro.props;

const Tag = href ? 'a' : 'button';
const attrs = href ? { href } : { type: 'button' as const };
---

<Tag
  class:list={['btn', `btn--${variant}`, `btn--${size}`, { 'btn--block': block }, className]}
  {...attrs}
  {...rest}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1.5px solid transparent;
    border-radius: var(--radius);
    font-family: inherit;
    font-weight: 700;
    font-size: 17px;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      color 0.15s;
  }

  /* Sizes (the 1.5px border is already included in the padding) */
  .btn--md {
    padding: 13.5px 26.5px;
  }
  .btn--sm {
    padding: 9.5px 20.5px;
    font-size: 16px;
  }
  .btn--block {
    display: flex;
    width: 100%;
  }

  /* Gold — the main call to action */
  .btn--primary {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--green-deep);
  }
  .btn--primary:hover {
    background: var(--gold-hover);
    border-color: var(--gold-hover);
    color: var(--green-deep);
  }

  /* Green outline — the secondary action */
  .btn--outline {
    background: transparent;
    border-color: var(--green);
    color: var(--green);
  }
  .btn--outline:hover {
    background: rgba(33, 73, 53, 0.06);
    color: var(--green);
  }

  /* Solid green — form submit buttons */
  .btn--solid {
    background: var(--green);
    border-color: var(--green);
    color: #fff;
  }
  .btn--solid:hover {
    background: var(--green-deep);
    border-color: var(--green-deep);
    color: #fff;
  }
</style>
