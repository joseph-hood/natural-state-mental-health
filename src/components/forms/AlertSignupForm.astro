---
/**
 * AlertSignupForm — email + optional mobile number for legislative alerts.
 *
 * TODO(forms): submission is a placeholder. See src/scripts/form-todo.ts.
 * TODO(legal): the "Privacy Policy" link points to /privacy, a page that
 * doesn't exist yet. Text-message programs normally require a published
 * privacy policy, so one needs to be written and added.
 */
import Button from '../ui/Button.astro';
import Field from './Field.astro';

interface Props {
  idPrefix?: string;
}

const { idPrefix = 'alerts' } = Astro.props;
---

<form class="alert-form" method="post" data-form-todo aria-label="Legislative alerts sign-up">
  <div class="row">
    <Field
      id={`${idPrefix}-email`}
      name="email"
      label="Email address"
      type="email"
      autocomplete="email"
      placeholder="Email address"
      size="lg"
      required
      hideLabel
    />
    <Field
      id={`${idPrefix}-mobile`}
      name="mobile"
      label="Mobile number (optional)"
      type="tel"
      autocomplete="tel"
      placeholder="Mobile (optional)"
      size="lg"
      hideLabel
    />
  </div>
  <Button type="submit" variant="solid" block>Sign up for alerts</Button>
  <p class="status" role="status" data-form-status hidden></p>
  <p class="legal">
    By providing your mobile number, you agree to receive recurring text messages from Natural State Mental
    Health. Msg &amp; data rates may apply. Reply STOP to opt out, HELP for help. See our{' '}
    <a href="/privacy">Privacy Policy</a>.
  </p>
</form>

<script>
  import '../../scripts/form-todo.ts';
</script>

<style>
  .alert-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 10px;
  }
  /* The input borders sit on the sand-coloured panel; Field's default
     border colour already passes contrast there. */
  .legal {
    font-size: 13px;
    line-height: 1.5;
    color: #4a5248;
  }
  .legal a {
    color: var(--green-deep);
  }
  .status {
    padding: 12px 14px;
    border-left: 4px solid var(--gold-dark);
    background: #fff;
    border-radius: 4px;
    font-size: 15px;
    color: var(--ink);
  }
</style>
