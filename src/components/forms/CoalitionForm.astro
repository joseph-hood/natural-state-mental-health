---
/**
 * CoalitionForm — "Sign on as a member" card.
 * Used on the home page and the Join the Coalition page.
 *
 * TODO(forms): submission is a placeholder. See src/scripts/form-todo.ts.
 */
import { iAmOptions } from '../../data/coalition';
import Button from '../ui/Button.astro';
import Field from './Field.astro';

interface Props {
  /** Keeps field ids unique if the form ever appears twice on one page. */
  idPrefix?: string;
  /** Heading tag for the card title, so it fits under the page's own headings. */
  headingLevel?: 2 | 3;
}

const { idPrefix = 'coalition', headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<form class="coalition-form" method="post" data-form-todo aria-labelledby={`${idPrefix}-title`}>
  <Heading class="title" id={`${idPrefix}-title`}>Sign on as a member</Heading>
  <p class="required-note"><span aria-hidden="true">*</span> Required</p>

  <div class="row">
    <Field id={`${idPrefix}-first`} name="first_name" label="First name" autocomplete="given-name" required />
    <Field id={`${idPrefix}-last`} name="last_name" label="Last name" autocomplete="family-name" required />
  </div>
  <div class="row">
    <Field id={`${idPrefix}-email`} name="email" label="Email" type="email" autocomplete="email" required />
    <Field id={`${idPrefix}-phone`} name="phone" label="Phone" type="tel" autocomplete="tel" />
  </div>
  <div class="row">
    <Field id={`${idPrefix}-zip`} name="zip_or_county" label="ZIP or county" autocomplete="off" />
    <Field id={`${idPrefix}-role`} name="role" label="I am a…" as="select" options={iAmOptions} />
  </div>
  <Field
    id={`${idPrefix}-org`}
    name="organization"
    label="Organization"
    hint="Optional — if signing on as a group"
    autocomplete="organization"
  />
  <Field
    id={`${idPrefix}-message`}
    name="message"
    label="Message"
    hint="Optional — why this matters to you"
    as="textarea"
    rows={3}
  />

  <label class="check">
    <input type="checkbox" name="will_contact_legislators" value="yes" />
    I'm willing to call or write my state legislators.
  </label>

  <Button type="submit" variant="solid" block>Join the Coalition</Button>

  <!-- Shown by src/scripts/form-todo.ts after pressing the button. -->
  <p class="status" role="status" data-form-status hidden></p>
</form>

<script>
  import '../../scripts/form-todo.ts';
</script>

<style>
  .coalition-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(22px, 3vw, 36px);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 12px 40px rgba(20, 54, 33, 0.07);
  }
  .title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.2;
    color: var(--green-deep);
  }
  .required-note {
    margin-top: -10px;
    font-size: 14px;
    color: var(--text-subtle);
  }
  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 14px;
  }
  .check {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    color: var(--text);
    cursor: pointer;
  }
  .check input {
    flex: none;
    width: 18px;
    height: 18px;
    margin: 3px 0 0;
    accent-color: var(--green);
  }
  .status {
    padding: 12px 14px;
    border-left: 4px solid var(--gold-dark);
    background: var(--gold-wash);
    border-radius: 4px;
    font-size: 15px;
    color: var(--ink);
  }
</style>
