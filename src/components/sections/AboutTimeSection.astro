---
/**
 * "It's About Time" — cards showing what other states have done,
 * with official vote records and a pull quote.
 */
import { states } from '../../data/states';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import StateCard from '../cards/StateCard.astro';
---

<Section tone="tint" labelledby="about-time-heading">
  <div class="stack">
    <SectionHeading
      id="about-time-heading"
      eyebrow="Our neighbors are moving"
      title="It’s About Time."
      maxWidth="720px"
    >
      <p>
        States like ours are already acting on psychedelic therapy,
        often with broad bipartisan support.
      </p>
    </SectionHeading>

    <ul class="cards" role="list">
      {
        states.map((state) => (
          <li>
            <StateCard state={state} />
          </li>
        ))
      }
    </ul>

    <p class="source-note">
      Selected legislative votes, 2025–2026. House passage alone
      does not mean a bill became law.
    </p>

    <blockquote class="pull">
      Other conservative, rural, veteran-heavy states are not
      sitting this out, and neither should we.
    </blockquote>
  </div>
</Section>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 16px;
  }

  .source-note {
    color: var(--text-subtle);
    font-size: 15px;
    margin-top: -20px;
  }

  .pull {
    max-width: 820px;
    padding-left: 20px;
    border-left: 3px solid var(--gold);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(21px, 2vw, 26px);
    line-height: 1.4;
    color: var(--green-deep);
    text-wrap: pretty;
  }
</style>
