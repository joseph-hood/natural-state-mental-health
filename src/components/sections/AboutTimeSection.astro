---
/**
 * "It's About Time" — cards showing what other states have done, ending on
 * Arkansas's "2027" card and a pull quote.
 *
 * The design explored three versions (cards / tile map / ledger). This is the
 * "cards" version, which is what the approved homepage mockup uses.
 */
import { states } from '../../data/states';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ArrowLink from '../ui/ArrowLink.astro';
import StateCard from '../cards/StateCard.astro';
---

<Section tone="tint" labelledby="about-time-heading">
  <div class="stack">
    <SectionHeading
      id="about-time-heading"
      eyebrow="Our neighbors are moving"
      title="It’s About Time."
      maxWidth="720px"
    >
      <p>States like ours are already acting on psychedelic therapy, often with broad bipartisan support.</p>
    </SectionHeading>

    <ul class="cards" role="list">
      {
        states.map((state) => (
          <li>
            <StateCard state={state} />
          </li>
        ))
      }
      <li>
        <article class="ark">
          <h3 class="name">Arkansas</h3>
          <p class="big">2027</p>
          <p class="note">Never attempted. Let's change that.</p>
          <ArrowLink href="/join" class="join">Join the coalition</ArrowLink>
        </article>
      </li>
    </ul>

    <blockquote class="pull">
      Other conservative, rural, veteran-heavy states are not sitting this out, and neither should we.
    </blockquote>
  </div>
</Section>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 16px;
  }

  /* Arkansas's own card: warm background + dashed border to stand out */
  .ark {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: 24px;
    background: var(--gold-wash);
    border: 1.5px dashed var(--gold-dark);
    border-radius: 10px;
    --link-color: var(--green-deep);
  }
  .name {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .big {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 30px;
    line-height: 1.1;
    color: var(--green-deep);
  }
  .note {
    font-size: 15px;
    line-height: 1.45;
    color: var(--text);
  }
  .ark :global(.join) {
    margin-top: auto;
    font-size: 15px;
  }

  .pull {
    max-width: 820px;
    padding-left: 20px;
    border-left: 3px solid var(--gold);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(21px, 2vw, 26px);
    line-height: 1.4;
    color: var(--green-deep);
    text-wrap: pretty;
  }
</style>
