---
/** "What the research shows" — intro text beside a numbered grid of conditions. */
import { SITE } from '../../config/site';
import { conditions } from '../../data/states';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ArrowLink from '../ui/ArrowLink.astro';
---

<Section labelledby="research-heading">
  <div class="grid">
    <div class="copy">
      <SectionHeading id="research-heading" eyebrow="The evidence" title="What the research shows.">
        <p>
          Clinical trials at leading research institutions are studying psilocybin-assisted therapy for
          conditions that affect thousands of Arkansas families.
        </p>
      </SectionHeading>
      <!-- TODO: point this at the real research summary once it exists. For now it goes to the
           research post, so it's hidden while the blog is (SITE.showBlog). -->
      {
        SITE.showBlog && (
          <ArrowLink href="/blog/what-the-research-says-about-psilocybin-and-ptsd">
            Read the research summary
          </ArrowLink>
        )
      }
    </div>

    <ol class="conditions" role="list">
      {
        conditions.map((name, index) => (
          <li class="cell">
            <span class="num" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="name">{name}</span>
          </li>
        ))
      }
    </ol>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .conditions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
    border-top: 1px solid var(--line-strong);
    border-left: 1px solid var(--line-strong);
  }
  .cell {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 92px;
    padding: 22px 20px;
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }
  .cell:hover {
    background: rgba(33, 73, 53, 0.04);
  }
  .num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-subtle);
  }
  .name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 21px;
    line-height: 1.2;
    color: var(--green-deep);
  }
</style>
