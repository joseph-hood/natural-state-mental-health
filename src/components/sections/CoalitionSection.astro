---
/** "Join the coalition" — who we're looking for, beside the sign-on form. */
import { memberTypes } from '../../data/coalition';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import CoalitionForm from '../forms/CoalitionForm.astro';
---

<Section labelledby="coalition-heading">
  <div class="grid">
    <div class="copy">
      <SectionHeading
        id="coalition-heading"
        eyebrow="Join the coalition"
        title="Add your name. Add your voice."
      >
        <p>
          We're looking for concerned individuals and groups to review our initiatives, call their
          representatives, and sign on as official coalition members.
        </p>
      </SectionHeading>

      <ul class="roles" role="list">
        {
          memberTypes.map(({ label, icon: Icon }) => (
            <li class="role">
              <Icon size={20} />
              {label}
            </li>
          ))
        }
      </ul>
    </div>

    <CoalitionForm />
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(36px, 5vw, 72px);
    align-items: start;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .roles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
  }
  .role {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border: 1px solid rgba(33, 73, 53, 0.16);
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--green-deep);
  }
  .role :global(svg) {
    flex: none;
    color: var(--green);
  }
</style>
